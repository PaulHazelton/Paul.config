		"MarkdownInlineCode": "#ff0475"
	},
	"Mappings": {
		"Visual.Studio.2019": {
			"Keywords": [ "Keyword", "XML Name", "XML Doc Comments - Name" ],
			"Strings": [ "String", "String - Verbatim" ],
