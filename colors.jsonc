				"Strings": [ "strings" ]
			},
			"textMateRules.scope": {
				"MarkdownHeading": [ "markup.heading.markdown" ],
				"MarkdownInlineCode": [ "markup.inline.raw" ],
				"Types": [ "support.type.property-name" ],
